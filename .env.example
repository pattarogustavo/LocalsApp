# Copy this file to .env and fill in real values. Never commit .env.

# --- Database ---
DATABASE_URL=

# --- Supabase Auth (frontend + backend) ---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Settings > API > JWT Secret (backend verifies user sessions with this)
SUPABASE_JWT_SECRET=
# Settings > API > service_role secret key. Server-only — never expose to the client bundle.
SUPABASE_SERVICE_ROLE_KEY=
# Name of the private Supabase Storage bucket used for uploads
SUPABASE_STORAGE_BUCKET=

# --- Anthropic (AI) ---
ANTHROPIC_API_KEY=
# Optional, defaults to a Claude Sonnet model if unset
ANTHROPIC_MODEL=

# --- Third-party integrations already in use ---
GOOGLE_PLACES_API_KEY=
GOOGLE_DIRECTIONS_API_KEY=
AERODATABOX_RAPIDAPI_KEY=
AVIATIONSTACK_API_KEY=
OPENWEATHERMAP_API_KEY=
REVENUECAT_API_KEY_APPLE=
REVENUECAT_API_KEY_GOOGLE=
# Public SDK key used by the client (react-native-purchases). Needs the
# EXPO_PUBLIC_ prefix to be bundled into the client app — unlike the two
# keys above, which are server/build-only secrets. Same value as
# REVENUECAT_API_KEY_APPLE (or the platform-appropriate public key).
EXPO_PUBLIC_REVENUECAT_API_KEY=
# Shared secret for verifying RevenueCat webhook requests. Generate a strong
# random value and configure the *same* value in RevenueCat under
# Project Settings -> Integrations -> Webhooks -> Authorization header.
REVENUECAT_WEBHOOK_SECRET=
# Last-resort destination cover photo fallback (Unsplash search API)
UNSPLASH_ACCESS_KEY=

PORT=3000
